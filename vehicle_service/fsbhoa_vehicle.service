[Unit]
Description=FSBHOA Vehicle Access Control Gateway & Correlation Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=www-data
WorkingDirectory=/var/lib/fsbhoa
ExecStart=/usr/local/bin/fsbhoa_vehicle -config /var/lib/fsbhoa/vehicle_service.json
Restart=always
RestartSec=3s

# Hold RAM's listener and connections while the service restarts, so RAM's Live Streaming
# isn't cut (CLAUDE.md, "RAM connection hold"). The service hands the sockets to systemd
# with sd_notify, which needs NotifyAccess. The store is kept across a restart (systemctl
# restart, or Restart= after a crash) but released by a stop.
NotifyAccess=main
FileDescriptorStoreMax=32

# Standard logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fsbhoa_vehicle

# Security sandboxing
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
